# =============================================================================
# FarmPOA Backend — Environment Variables
# Copy this file to .env and fill in values. Never commit .env.
# =============================================================================

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
API_PREFIX=/api/v1
SHUTDOWN_TIMEOUT_MS=10000

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=your-256-bit-secret-here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── Africa's Talking (SMS/USSD) ───────────────────────────────────────────────
AT_API_KEY=your-africastalking-api-key
AT_USERNAME=your-africastalking-username
AT_SENDER_ID=FarmPOA

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_PRETTY=true

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,https://app.farmpoa.co.ke

# ── Internal ──────────────────────────────────────────────────────────────────
INTERNAL_API_KEY=your-internal-service-key
